# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================

# Enable/disable Telegram notifications
TELEGRAM_ENABLED=false

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get from https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot
TELEGRAM_CHAT_ID=your_chat_id_here

# =============================================================================
# ARBITRAGE SETTINGS
# =============================================================================

# Minimum profit percentage to trigger alert (default: 1.0)
MIN_PROFIT_PERCENT=1.0

# Maximum profit percentage - filter likely errors (default: 15.0)
MAX_PROFIT_PERCENT=15.0

# Default stake for calculations in EUR (default: 100)
DEFAULT_STAKE=100

# Refresh interval in seconds (default: 60)
REFRESH_INTERVAL=60

# =============================================================================
# PLATFORM TOGGLES
# =============================================================================

ENABLE_AZURO=true
ENABLE_OVERTIME=true
ENABLE_DEXSPORT=true
ENABLE_SPORTBET=true

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
LOG_FILE=arb_finder.log

# =============================================================================
# OPTIONAL: CEFI PLATFORMS (require API keys)
# =============================================================================

# Betfair Exchange API
# BETFAIR_APP_KEY=
# BETFAIR_USERNAME=
# BETFAIR_PASSWORD=
